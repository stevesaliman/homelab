#!/usr/bin/env python

# WIP
# TODO clean this up

"""
Basic configure script for new users

It is mostly used to change the repo, domain, timezone, etc. from Kuhe Doan's values to our own.
It is important to push changes after running this script so that Argo uses the right repo for
deployment.
"""

import fileinput
import subprocess
import sys

from rich.prompt import Confirm, Prompt

# These are the current values in the upstream repo, a.k.a. the values to be replaced.  Don't
# change these until after you've run it, then change them again after each run.
upstream_config = {
    "seed_repo": "https://github.com/stevesaliman/homelab",
    "seed_repo_revision": "master",
    "domain": "saliman.net",
    "timezone": "America/Denver",
    "terraform_workspace": "saliman",
    "loadbalancer_ip_range": "192.168.1.224/27",
}


def check_python_version(required_version: str) -> None:
    if sys.version_info < tuple(map(int, required_version.split('.'))):
        raise Exception(f"Must be using Python >= {required_version}")


def find_and_replace(pattern: str, replacement: str, paths: list[str]) -> None:
    files_with_matches = subprocess.run(
        ["git", "grep", "--files-with-matches", pattern, "--"] + paths,
        capture_output=True,
        text=True
    ).stdout.splitlines()

    for file_with_matches in files_with_matches:
        with fileinput.FileInput(file_with_matches, inplace=True) as file:
            for line in file:
                print(line.replace(pattern, replacement), end='')


def main() -> None:
    check_python_version(
        required_version='3.10.0'
    )

    editor = Prompt.ask("Select text editor", default='vim')
    domain = Prompt.ask("Enter your domain", default=upstream_config['domain'])
    seed_repo = Prompt.ask("Enter seed repo", default=upstream_config['seed_repo'])
    seed_repo_revision = Prompt.ask("Enter seed repo_revision", default=upstream_config['seed_repo_revision'])
    timezone = Prompt.ask("Enter time zone", default=upstream_config['timezone'])
    loadbalancer_ip_range = Prompt.ask("Enter IP range for load balancer", default=upstream_config['loadbalancer_ip_range'])

    find_and_replace(
        pattern=upstream_config['domain'],
        replacement=domain,
        paths=[
            ".ci",
            "apps",
            "platform",
            "system",
            "external"
        ]
    )

    find_and_replace(
        pattern=upstream_config['seed_repo'],
        replacement=seed_repo,
        paths=[
            "system",
            "platform"
        ]
    )

    # This one's a little different.  We need to tell Argo to track the right revision of the
    # homelab repo, but a simple string substitution is not enough, because words like "master" and
    # "dev" are used all over the place.  So this replacement targets just the argocd value files,
    # taking advantage of the special "&revision" tokens that are in them.
    find_and_replace(
        pattern="&revision " + upstream_config['seed_repo_revision'],
        replacement="&revision " + seed_repo_revision,
        paths=[
            "system/argocd"
        ]
    )

    find_and_replace(
        pattern=upstream_config['timezone'],
        replacement=timezone,
        paths=[
            "apps",
            "system",
            "metal"
        ]
    )

    find_and_replace(
        pattern=upstream_config['loadbalancer_ip_range'],
        replacement=loadbalancer_ip_range,
        paths=[
            "metal/inventories/prod.yml",
            "apps/tailscale/values.yaml",
        ]
    )

    if Confirm.ask("Update server list?", default=True):
        subprocess.run(
            [editor, 'metal/inventories/prod.yml']
        )


    if Confirm.ask("Do you want to use managed services?"):
        terraform_workspace = Prompt.ask("Enter Terraform Workspace", default=upstream_config['terraform_workspace'])

        find_and_replace(
            pattern=upstream_config['terraform_workspace'],
            replacement=terraform_workspace,
            paths=[
                "external/versions.tf"
            ]
        )


if __name__ == '__main__':
    main()
